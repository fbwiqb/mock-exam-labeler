{
  "name": "mock-exam-labeler",
  "version": "0.3.3",
  "description": "Local label editor for Korean mock exam illustrations",
  "main": "electron/main.js",
  "author": {
    "name": "CNSA",
    "email": "drmin01@naver.com"
  },
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win nsis portable",
    "pack": "electron-builder --dir",
    "check": "node --check electron/main.js && node --check electron/preload.js && node --check src/renderer.js"
  },
  "build": {
    "appId": "kr.cnsa.mockExamLabeler",
    "productName": "모의고사 라벨러",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "signAndEditExecutable": false,
      "target": [
        "nsis",
        "portable"
      ]
    },
    "publish": {
      "provider": "github",
      "owner": "fbwiqb",
      "repo": "mock-exam-labeler"
    },
    "fileAssociations": [
      {
        "ext": "melp",
        "name": "Mock Exam Labeler Project",
        "description": "모의고사 라벨러 프로젝트",
        "role": "Editor"
      }
    ],
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "모의고사 라벨러",
      "artifactName": "mock-exam-labeler-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "mock-exam-labeler-portable-${version}.${ext}"
    }
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
